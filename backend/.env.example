DATABASE_URL=postgresql+psycopg://og_pios:og_pios_dev_password@db:5432/og_pios
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# AI Insights module — optional. Leave AI_PROVIDER=none (or unset) to run entirely on the
# deterministic rule-based engine and the NullProvider's template responses; the app is fully
# functional with none of the below set. Set AI_PROVIDER to exactly one of
# openai|anthropic|google|local and its matching key/URL below to enable AI-authored
# interpretation text on insights/the assistant/the daily brief. Never commit real values.
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=

# Password reset / email verification — optional. MAIL_PROVIDER=console (the default) never
# sends a real email — it logs the message, and the API response echoes the reset/verification
# token or link when ENVIRONMENT=development, so the whole flow is testable without any mail
# infrastructure. MUST NOT be used in a real deployment with real end users. Set
# MAIL_PROVIDER=resend and RESEND_API_KEY below to send real emails via Resend
# (https://resend.com) — falls back to console if the key is missing. MAIL_FROM_ADDRESS defaults
# to Resend's shared onboarding@resend.dev sender (works without verifying a domain); override
# once you've verified your own sending domain with Resend.
RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:3000
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM_ADDRESS=OG-PIOS <onboarding@resend.dev>
